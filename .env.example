# PostgreSQL connection string, for example from Neon (https://neon.tech).
# Leave empty to use PGlite: an in-process Postgres that migrates and seeds itself.
DATABASE_URL=

# Password for the seeded staff accounts (officer@council.example, manager@council.example).
STAFF_DEMO_PASSWORD=demo-password

# Set to false to hide the demo account details on the staff sign-in page.
DEMO_MODE=true

# Protects /api/cron/purge-drafts. Vercel sends it automatically to cron jobs.
CRON_SECRET=
